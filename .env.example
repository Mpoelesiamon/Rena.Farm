# Rena Farm — Public Website Environment Variables
# Copy this file to .env and fill in values for local development.
# For Vercel: add these in Project → Settings → Environment Variables.

# Supabase
# The anon key is safe to expose in frontend code — it is a public key.
# Security is enforced via Row Level Security (RLS) policies in the database.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
